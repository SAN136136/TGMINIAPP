          {"name": "Путь при равноускоренном", "formula": "S = v₀t + at²/2"},
          {"name": "Второй закон Ньютона", "formula": "F = ma"},
          {"name": "Сила тяжести", "formula": "F = mg"},
          {"name": "Давление", "formula": "P = F/S"}
        ]
      },
